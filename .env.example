# development | production
# production refuses default/short WORKBENCH_SECRET_KEY
WORKBENCH_ENV=development

# Optional directory for workbench.db / demo.db (Docker sets /app/data)
# WORKBENCH_DATA_DIR=

# Encrypt stored DB passwords / LLM keys (use a long random string in production)
WORKBENCH_SECRET_KEY=change-me-to-a-long-random-string

# Administrator key for connection/policy/settings management and the setup UI.
# Required in production. Generate independently from the encryption/operator keys.
WORKBENCH_ADMIN_API_KEY=

# Optional restricted API credential, sent as X-API-Key or Authorization: Bearer.
# Both API keys empty permits loopback-only development access.
WORKBENCH_API_KEY=
WORKBENCH_API_ROLE=reader
# reader = queries only; writer = queries and confirmed mutations.
# Comma-separated connection IDs assigned by the administrator. Empty = no access.
WORKBENCH_CONNECTION_IDS=

# Server-controlled destination allowlists. Empty DB list denies network databases.
# Exact hostnames or IPs, comma-separated; do not put URLs here.
WORKBENCH_DB_HOSTS=
# Additional approved HTTPS model hosts (port 443 only).
# api.deepseek.com and api.openai.com are built in.
WORKBENCH_LLM_HOSTS=
# Additional SQLite directories, separated by ; on Windows or : on Linux.
# WORKBENCH_DATA_DIR is already allowed; workbench.db is always forbidden.
WORKBENCH_SQLITE_DIRS=

# LLM (required for NL query / mutate / schema interpret)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Request/result budgets. Positive integers; restart after changing.
WORKBENCH_MAX_REQUEST_BYTES=1048576
WORKBENCH_MAX_RESULT_BYTES=4194304
# Concurrency limits are per worker; counters below share the metadata database.
WORKBENCH_MAX_CONCURRENT_REQUESTS=8
WORKBENCH_MAX_TOTAL_REQUESTS=32
WORKBENCH_REQUESTS_PER_MINUTE=120
WORKBENCH_LLM_CALLS_PER_HOUR=60
WORKBENCH_LLM_TOTAL_CALLS_PER_HOUR=120
WORKBENCH_MAX_LLM_INPUT_BYTES=131072
WORKBENCH_MAX_LLM_OUTPUT_TOKENS=4096
