# development | production
# production refuses default/short WORKBENCH_SECRET_KEY
WORKBENCH_ENV=development

# Optional directory for workbench.db / demo.db (Docker sets /app/data)
# WORKBENCH_DATA_DIR=

# Encrypt stored DB passwords / LLM keys (use a long random string in production)
WORKBENCH_SECRET_KEY=change-me-to-a-long-random-string

# Shared API key for /api/* (X-API-Key or Authorization: Bearer).
# Empty = disabled in development. Required (≥16 chars) when WORKBENCH_ENV=production.
WORKBENCH_API_KEY=

# LLM (required for NL query / mutate / schema interpret)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
