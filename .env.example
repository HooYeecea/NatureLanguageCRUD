# development | production
# production refuses default/short WORKBENCH_SECRET_KEY
WORKBENCH_ENV=development

# Encrypt stored DB passwords / LLM keys (use a long random string in production)
WORKBENCH_SECRET_KEY=change-me-to-a-long-random-string

# LLM (required for NL query / mutate / schema interpret)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
